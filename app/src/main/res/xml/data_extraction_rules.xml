<?xml version="1.0" encoding="utf-8"?>

<!-- Reglas de extracción de datos para Android 12+ (API 31+).
   Cloud Backup: respaldo en la nube del dispositivo.
   Device Transfer: transferencia directa entre dispositivos. -->

<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir datos de sesión -->
        <exclude domain="sharedpref" path="sesion.xml"/>
        <exclude domain="sharedpref" path="credenciales.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Excluir datos de sesión -->
        <exclude domain="sharedpref" path="sesion.xml"/>
        <exclude domain="sharedpref" path="credenciales.xml"/>
    </device-transfer>
</data-extraction-rules>